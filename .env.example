# Copy to .env and adjust if you changed docker-compose.yml.
#   cp .env.example .env
# .env is gitignored — never commit real credentials.

DATABASE_URL=postgresql+psycopg://banking:banking@localhost:5432/banking

# A separate database. The test suite truncates tables between cases, so pointing
# this at the development database above would wipe your data on every `pytest`.
TEST_DATABASE_URL=postgresql+psycopg://banking:banking@localhost:5432/banking_test

# Set to true to log every SQL statement.
SQL_ECHO=false

# Signs and verifies access tokens. Anyone holding this value can mint a token
# for any user, so a real deployment would keep it out of the repo entirely.
# This is a throwaway key for the assessment build. Regenerate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=eadHXglOQMP8B5YP2v2gpBWoBE3JttzBDXxzu65-Amc
